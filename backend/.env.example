APP_ENV=dev
# Leave empty for backend/data/mde-ng-dev.sqlite3 (workspace and reference files).
DATABASE_URL=
# Node.js 24 or newer is discovered automatically. Set only to override discovery.
# NODE_BINARY=/path/to/node
FRONTEND_ORIGIN=http://localhost:5173
# Defaults to backend/data/mde-ng-accounts.sqlite3.
# AUTH_DATABASE_PATH=/private/path/accounts.sqlite3
# SESSION_MINUTES=480

# Offline processing is the default. Use azure-openai only with synthetic sources.
INTAKE_PROVIDER=local
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-structured-output-capable-deployment
# AZURE_OPENAI_API_KEY=set-in-the-server-environment
